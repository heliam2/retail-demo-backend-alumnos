# @karatelabs/karate trae un script "preinstall" que siempre intenta bajar
# karate-core:LATEST:all desde Maven Central, pero desde la version 2.0.0 ese
# jar "-all" ya no se publica alli (solo hasta 1.5.2), asi que el preinstall
# falla y con el rompe cualquier "npm install" del proyecto completo.
# No hace falta: jbang se autoinstala de forma perezosa la primera vez que
# corre karate/run.js (que fija karate.version = "1.5.2", version que si
# tiene el jar publicado). Ninguna otra dependencia del proyecto necesita
# scripts de instalacion (bcryptjs es JS puro).
ignore-scripts=true
